# Copy to .env (or export in your shell) before starting GameWorker.
# Ollama must be running: https://ollama.com

# Use local Ollama via its OpenAI-compatible API
AIGM_LLM_CLIENT=ollama
AIGM_LLM_BASE_URL=http://127.0.0.1:11434
AIGM_LLM_MODEL=llama3.1

# JSON response_format is off by default for Ollama (prompts still ask for JSON).
# Turn on if your model supports OpenAI json_object mode:
# AIGM_LLM_JSON_MODE=true

# Longer timeout helps on first load / large models
AIGM_LLM_TIMEOUT_SECONDS=180
